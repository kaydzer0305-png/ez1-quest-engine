#! /usr/bin/env python
# encoding: utf-8

from waflib import Utils
import os
import vpc_parser

top = '.'
PROJECT_NAME = 'client'

def options(opt):
	return

games = {
	'hl2': ['client_base.vpc', 'client_hl2.vpc'],
	# Extra EZ1 units (APC client, particles) sit in client_ez1_extras.vpc.
	'ez1': ['client_base.vpc', 'client_hl2.vpc', 'client_ez1_extras.vpc'],
	# EZ2 target profile. M1 ships wiring + the ez2vr client convars only.
	'ez2': ['client_base.vpc', 'client_hl2.vpc', 'client_ez2_extras.vpc'],
	'hl2mp': ['client_base.vpc', 'client_hl2mp.vpc'],
	'hl1': ['client_base.vpc', 'client_hl1.vpc'],
	'episodic': ['client_base.vpc', 'client_episodic.vpc'],
	'portal': ['client_base.vpc', 'client_portal.vpc'],
	'hl1mp': ['client_base.vpc', 'client_hl1mp.vpc'],
	'cstrike': ['client_base.vpc', 'client_cstrike.vpc'],
	'dod': ['client_base.vpc', 'client_dod.vpc']
}

def configure(conf):
	game = conf.options.GAMES
	conf.env.GAMES = game

	conf.env.append_unique('DEFINES', ['DISABLE_STEAM=1'])

	if game not in games.keys():
		conf.fatal("Couldn't find game: ", game)

	if game == 'ez1':
		conf.env.append_unique('DEFINES', ['EZ=1', 'EZ1=1', 'HE_APC=1', 'GLOWS_ENABLE=1'])

	# Must match EZ2's client_ez2.vpc $PreprocessorDefinitions.
	if game == 'ez2':
		conf.env.append_unique('DEFINES',
			['EZ=1', 'EZ2=1', 'HE_APC=1', 'GLOWS_ENABLE=1', 'CSS_WEAPONS_IN_HL2=1'])
def build(bld):
	game = vpc_parser.parse_vpcs( bld.env, games[bld.env.GAMES], '../..' )

	includes = [
		'.',
		'game_controls',
		'../../common',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../vgui2/include',
		'../../vgui2/controls',
		'../shared'
	]

	if bld.env.GAMES == 'ez1':
		includes += [
			'Human_Error',
			'../server/ez1',
			'../server/ez2',
			'../server/mod',
			'../server/Human_Error',
		]

	# M2: the EZ2 player/weapon client roster. The client reaches the server
	# EZ2 headers (ez2_player.h, weapon_displacer_pistol.h) the same way the ez1
	# profile does. The shared ez2vr/ez2 headers resolve through the
	# $AdditionalIncludeDirectories in client_ez2_extras.vpc.
	if bld.env.GAMES == 'ez2':
		includes += [
			'ez2',
			'ez2vr',
			'Human_Error',
			'../server/ez2',
			'../server/Human_Error',
		]

	libs = [
		'tier0',
		'particles',
		'dmxloader',
		'vgui_controls',
		'matsys_controls',
		'tier1',
		'tier2',
		'tier3',
		'mathlib',
		'vstdlib',
		'choreoobjects',
		'steam_api',
		'bitmap',
		'vtf',
		'RT',
		'ZLIB'
	]

	install_path = bld.env.PREFIX
	if bld.env.DEST_OS != 'android':
		install_path += '/'+bld.env.GAMES+'/bin'

	source = [ 'in_touch.cpp' ]
	if bld.env.DEST_OS == 'win32':
		libs += ['USER32']

	source += game["sources"] + ['../../public/tier0/memoverride.cpp']
	includes += game["includes"]
	defines = game["defines"]

	defines.remove('PROTECTED_THINGS_ENABLE')

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		install_path = install_path,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)
