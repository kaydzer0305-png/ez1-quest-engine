<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ezquest.engine"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34"/>
    <uses-feature android:glEsVersion="0x30002" android:required="true"/>

    <!-- Quest VR: register as a head-tracked VR app (modeled on SourceVR 0.5.1) -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="true"
        android:version="1"/>
    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false"/>
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING"/>

    <!-- OpenXR runtime access -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR"/>
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM"/>
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker"/>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService"/>
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService"/>
        </intent>
    </queries>

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Source Quest"
        android:hasCode="true"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true">
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="all"/>
        <!-- Active game profile (hl2 today; flip to ez1 once the mod game code merges) -->
        <meta-data
            android:name="com.ezquest.engine.GAME_PROFILE"
            android:value="hl2"/>
        <!-- 2D bootstrap entry (mirrors SourceVR's LauncherActivity): draws
             immediately so the system interstitial clears and focus flows,
             then starts the engine explicitly. No VR categories, like the
             reference. -->
        <activity
            android:name="com.ezquest.engine.LauncherActivity"
            android:label="Source Quest"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Flat engine: explicit-only entry, started by LauncherActivity
             once the app holds focus (see LauncherActivity). -->
        <activity
            android:name="com.valvesoftware.ValveActivity2"
            android:label="Source Quest"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="false">
        </activity>
        <!-- VR engine path (not the boot entry yet: native ANativeActivity_onCreate
             lands with slice D; no MAIN/LAUNCHER filter until then) -->
        <activity
            android:name="com.ezquest.engine.EngineActivity"
            android:label="Source Quest Engine"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:process=":engine"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ezquest.engine.action.START_ENGINE"/>
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD"/>
                <category android:name="com.oculus.intent.category.VR"/>
            </intent-filter>
            <meta-data
                android:name="android.app.lib_name"
                android:value="launcher"/>
        </activity>
        <activity
            android:name="com.ezquest.engine.RecoveryActivity"
            android:label="Source Quest"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:process=":recovery"
            android:exported="false"/>
        <activity
            android:name="com.ezquest.engine.ImportActivity"
            android:label="Source Quest Content Import"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:exported="false"/>
    </application>
</manifest>
